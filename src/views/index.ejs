                        class="bg-slate-900 border border-slate-700 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 outline-none transition text-white placeholder:text-slate-600">
                </div>
                
                <div class="flex flex-col space-y-2">
                    <label class="text-xs font-bold text-slate-400 uppercase ml-1">Adresa de Email</label>
                    <input type="email" id="email" placeholder="nume@companie.ro" required 
                        class="bg-slate-900 border border-slate-700 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 outline-none transition text-white placeholder:text-slate-600">
                </div>
                
                <div class="flex flex-col space-y-2 md:col-span-2">
                    <label class="text-xs font-bold text-slate-400 uppercase ml-1">Serviciul Solicitat</label>
                    <select id="serviciu" class="bg-slate-900 border border-slate-700 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 outline-none transition text-white appearance-none">
                        <option value="contabilitate">Evidență Contabilă Lunară</option>
                        <option value="consultanta">Consultanță Fiscală Strategică</option>
                        <option value="hr">Salarizare & HR </option>
                        <option value="audit">Audit sau Expertiză Judiciară</option>
                    </select>
                </div>

                <div class="flex flex-col space-y-2 md:col-span-2">
                    <label class="text-xs font-bold text-slate-400 uppercase ml-1">Mesaj / Detalii Proiect</label>
                    <textarea id="mesaj" placeholder="Spune-ne scurt despre afacerea ta..." rows="4" required
                        class="bg-slate-900 border border-slate-700 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 outline-none transition text-white placeholder:text-slate-600"></textarea>
                </div>
                
                <button type="submit" class="md:col-span-2 bg-blue-600 hover:bg-blue-700 text-white font-black py-5 rounded-xl transition duration-300 shadow-lg shadow-blue-900/20 transform hover:-translate-y-1 text-lg uppercase tracking-wider">
                    Trimite Solicitarea
                </button>
            </form>
            
            <div id="responseMessage" class="mt-8 text-center hidden p-4 rounded-xl font-bold"></div>
        </div>
    </section>

    <footer class="bg-slate-900 py-12 text-center border-t border-slate-800">
        <p class="text-slate-500 text-sm">© 2026 Cristina Baiura - Expert Contabil. Toate drepturile rezervate.</p>
    </footer>

    <script>
        // SCRIPT MOBIL
        const menuBtn = document.getElementById('menuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        if(menuBtn) {
            menuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
                mobileMenu.classList.toggle('flex');
            });
        }
        function toggleModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.toggle('hidden');
                document.body.style.overflow = modal.classList.contains('hidden') ? 'auto' : 'hidden';
            }
        }

        // LOGICA FORMULAR CONTACT
        document.getElementById('contactForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button');
            const msgBox = document.getElementById('responseMessage');
            
            btn.innerText = 'Se trimite...';
            btn.disabled = true;

            const data = {
                nume: document.getElementById('nume').value,
                email: document.getElementById('email').value,
                serviciu: document.getElementById('serviciu').value,
                mesaj: document.getElementById('mesaj').value
            };

            try {
                const response = await fetch('/contact', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    msgBox.innerText = 'Mesajul a fost trimis! Cristina te va contacta curând.';
                    msgBox.className = 'mt-8 text-center text-green-400 bg-green-400/10 p-4 rounded-xl block';
                    e.target.reset();
                } else { throw new Error(); }
            } catch (err) {
                msgBox.innerText = 'Eroare la trimitere. Încearcă direct pe WhatsApp.';
                msgBox.className = 'mt-8 text-center text-red-400 bg-red-400/10 p-4 rounded-xl block';
            } finally {
                btn.innerText = 'Trimite Solicitarea';
                btn.disabled = false;
            }
        });
    </script>

    <script>
        // Script pentru meniul mobile
        const btn = document.getElementById('menuBtn');
        const menu = document.getElementById('mobileMenu');
        btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
            menu.classList.toggle('flex');
        });

        // Scriptul tău de Contact Form (rămâne același)
    </script>
</body>
</html>